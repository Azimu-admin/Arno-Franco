{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "(?<sousdomaine>.*)\\.vercel\\.app"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:chemin*",
      "has": [
        {
          "type": "host",
          "value": "www.arnofranco.be"
        }
      ],
      "destination": "https://arnofranco.be/:chemin*",
      "permanent": true
    },
    {
      "source": "/:chemin*",
      "has": [
        {
          "type": "host",
          "value": "arno-franco.vercel.app"
        }
      ],
      "destination": "https://arnofranco.be/:chemin*",
      "permanent": true
    }
  ]
}
